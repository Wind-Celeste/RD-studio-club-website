server {
    listen 80;
    server_name rd-studio.club;
    root /www/wwwroot/rd-studio.club/current;
    index index.html;
    access_log /www/wwwlogs/rd-studio.club.access.log;
    error_log /www/wwwlogs/rd-studio.club.error.log;
    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/rd-studio.club/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location ~ /\. { deny all; }
    location / {
        try_files $uri $uri.html $uri/ =404;
    }
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    location ~ \.html$ {
        add_header Cache-Control "no-cache";
    }
    location = /supabase-rest.js {
        add_header Cache-Control "no-cache";
    }
    error_page 404 /404.html;
}
